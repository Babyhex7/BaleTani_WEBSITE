# ============================================
# ENVIRONMENT VARIABLES - ML RECOMMENDATION SERVICE
# Copy file ini menjadi .env dan sesuaikan nilai-nilainya
# ============================================

# === APPLICATION SETTINGS ===
APP_NAME="BaleTani ML Recommendation Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development | production
DEBUG=True
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR

# === API SETTINGS ===
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/v1"
API_KEY="baletani-ml-secret-key-change-this-in-production"

# === DATA SOURCE ===
DATA_SOURCE="csv"  # csv | mysql
CSV_DATA_PATH="./data/raw"

# === MYSQL DATABASE (untuk production) ===
# MYSQL_HOST="localhost"
# MYSQL_PORT=3306
# MYSQL_USER="baletani_user"
# MYSQL_PASSWORD="your_secure_password"
# MYSQL_DATABASE="baletani_db"

# === REDIS CACHE ===
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
CACHE_TTL_RECOMMENDATIONS=3600  # 1 jam (dalam detik)
CACHE_TTL_EMBEDDINGS=86400      # 24 jam

# === MODEL SETTINGS ===
MODEL_PATH="./models_artifacts"
MODEL_VERSION="ncb_v1.0"
EMBEDDING_DIM=32
BATCH_SIZE=32
TOP_K_RECOMMENDATIONS=10

# === TRAINING SETTINGS ===
TRAIN_TEST_SPLIT=0.7  # 70% training, 30% test+val
VALIDATION_SPLIT=0.15  # 15% validation dari total
EPOCHS=50
LEARNING_RATE=0.001
EARLY_STOPPING_PATIENCE=10

# === CORS SETTINGS ===
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
CORS_ALLOW_CREDENTIALS=True
