# ===== APPLICATION SETTINGS =====
app_name=BaleTani ML Recommendation Service
app_version=1.0.0
environment=development
debug=true
log_level=INFO

# ===== API SETTINGS =====
api_host=0.0.0.0
api_port=8000
api_prefix=/v1
api_key=baletani-ml-secret-key

# ===== DATA SOURCE =====
# Options: 'csv' or 'mysql'
# For development: use 'csv' for training, 'mysql' for inference
DATA_SOURCE=mysql

# Path untuk CSV data (untuk training)
csv_data_path=./data/raw

# ===== MYSQL DATABASE =====
# Connection ke BaleTani production database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=baletani_db
mysql_charset=utf8mb4
mysql_pool_size=10
mysql_max_overflow=20

# ===== REDIS CACHE (Optional) =====
redis_host=localhost
redis_port=6379
redis_db=0
redis_password=
cache_ttl_recommendations=3600
cache_ttl_embeddings=86400

# ===== MODEL SETTINGS =====
model_path=./models/saved_models
model_version=ncb_v4_test
embedding_dim=32
batch_size=32
top_k_recommendations=10

# ===== TRAINING SETTINGS =====
train_test_split=0.7
validation_split=0.15
epochs=50
learning_rate=0.001
early_stopping_patience=10

# ===== CORS SETTINGS =====
cors_origins=http://localhost:3000,http://localhost:5173,http://localhost:5174
cors_allow_credentials=true
