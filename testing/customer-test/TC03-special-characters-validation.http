# ============================================
# TEST: Validasi Karakter Spesial pada Username
# Test Case ID: #TC03
# ============================================

### 1. Register dengan Karakter Spesial (Seharusnya DITOLAK) ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567890",
  "full_name": "Pobi#$",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Nama hanya boleh berisi huruf, angka, spasi, titik, dan underscore. Karakter spesial tidak diperbolehkan"
# }

###

### 2. Register dengan Username Valid (Huruf, Angka, Spasi) ✅

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567891",
  "full_name": "Budi Santoso 123",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": true,
#   "message": "Registrasi berhasil"
# }

###

### 3. Register dengan Underscore dan Titik (Valid) ✅

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567892",
  "full_name": "John_Doe.Jr",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": true,
#   "message": "Registrasi berhasil"
# }

###

### 4. Register dengan Karakter @ (Seharusnya DITOLAK) ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567893",
  "full_name": "User@Email",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Nama hanya boleh berisi huruf, angka, spasi, titik, dan underscore. Karakter spesial tidak diperbolehkan"
# }

###

### 5. Register dengan Nama Terlalu Pendek (< 3 karakter) ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567894",
  "full_name": "AB",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Nama minimal 3 karakter"
# }

###

### 6. Register dengan Nama Spasi di Awal/Akhir ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567895",
  "full_name": " John Doe ",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Nama tidak boleh dimulai atau diakhiri dengan spasi"
# }

###

### 7. Register dengan Berbagai Karakter Spesial ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567896",
  "full_name": "Test!@#$%^&*()",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Nama hanya boleh berisi huruf, angka, spasi, titik, dan underscore. Karakter spesial tidak diperbolehkan"
# }

###

### 8. Register dengan Password Terlalu Pendek ❌

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567897",
  "full_name": "Valid Name",
  "password": "12345",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": false,
#   "message": "Password minimal 6 karakter"
# }

###

### 9. Register Nama dengan Huruf Indonesia (Valid) ✅

POST http://localhost:5000/api/customers/auth/register
Content-Type: application/json

{
  "phone_number": "081234567898",
  "full_name": "Ñoño García",
  "password": "password123",
  "address": "Jl. Test No. 123"
}

### Expected Response:
# {
#   "success": true,
#   "message": "Registrasi berhasil"
# }

