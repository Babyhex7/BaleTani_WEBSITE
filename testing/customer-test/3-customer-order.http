###############################################
# 🛍️ TEST SUITE: CUSTOMER ORDER & CHECKOUT
# File: 3-customer-order.http
# Deskripsi: Test lengkap untuk pembuatan order dan checkout
# PENTING: Perlu token customer & cart harus ada item!
###############################################

###############################################
# ⚠️ BACA INI DULU SEBELUM TESTING!
###############################################
# 🔴 URUTAN TESTING YANG BENAR:
# 1. Jalankan STEP 0.1 (Login) → COPY token → PASTE ke @customerToken
# 2. Jalankan STEP 0.2 (Add Cart) → Pastikan sukses
# 3. Jalankan TEST 1.1 (Create Order) → COPY order_id dari response
# 4. PASTE order_id ke @orderId di bawah ini
# 5. Baru jalankan TEST 3.x dan 4.x (History & Detail)
#
# ❌ JANGAN langsung jalankan TEST 4.1 tanpa update @orderId!
# ❌ UUID di bawah hanya CONTOH, bukan UUID real dari database!
# ❌ Jika langsung test tanpa create order dulu = 404 NOT FOUND!
###############################################

@baseUrl = http://localhost:5000

# ⚠️ UPDATE token setelah login (STEP 0.1):
@customerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI4MGVkNDgzZi03NWJjLTRjODYtOTE4ZC02NDUwNTQxMGI5MWMiLCJwaG9uZV9udW1iZXIiOiI2MjgxMjM0NTY3ODkwIiwidHlwZSI6ImN1c3RvbWVyIiwiaWF0IjoxNzYzNjEwMDM1LCJleHAiOjE3NjM2OTY0MzV9.JpT5LBWEFZYvqcgVRsqwZyWSl8SH-nTMo77Xkj-NYEo

# ⚠️ UPDATE orderId setelah create order (TEST 1.1) - UUID di bawah hanya CONTOH:
@orderId = 4eb98bd9-4e07-4be2-9a4a-999398889afd

# ⚠️ UPDATE productId dari database atau admin panel - Harus product yang is_active=true:
@productId1 = 9c8d0a8a-c506-11f0-b326-0a0027000015

###############################################
# ⚠️ SETUP: Login & Isi Cart Dulu!
###############################################

### STEP 0.1: Login Customer
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890",
  "password": "password123"
}

# 📝 RESPONSE akan berisi:
# {
#   "success": true,
#   "token": "eyJhbG...",  ← COPY TOKEN INI
#   "customer": {...}
# }
#
# ✅ PASTE token ke @customerToken di line 24!

###

### STEP 0.2: Tambah Produk ke Cart
POST {{baseUrl}}/api/customer/cart
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "product_id": "{{productId1}}",
  "quantity": 2
}

# 📝 Pastikan cart sudah ada item sebelum checkout!

###

###############################################
# 📦 TEST GROUP 1: CREATE ORDER - HAPPY PATH
###############################################

### TEST 1.1: Checkout - Delivery dengan Transfer Bank BRI
# Expected: 201 Created, order dibuat, WhatsApp link muncul
POST {{baseUrl}}/api/customer/orders/create
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "customer_name": "Budi Santoso",
  "customer_phone": "081234567890",
  "delivery_method": "delivery",
  "delivery_address": "Jl. Merdeka No. 45, Jakarta Pusat, DKI Jakarta 10110",
  "delivery_notes": "Tolong hubungi sebelum diantar, rumah pagar hijau",
  "payment_method": "transfer",
  "bank_name": "BRI",
  "items": [
    {
      "product_id": "{{productId1}}",
      "quantity": 2
    }
  ]
}

# ✅ Assertions:
# - Status: 201
# - Response has "success": true
# - Response has "data" object
# - data.order_number format: ORD-YYYYMMDD-XXXX
# - data.order_status === "pending_payment"
# - data.payment_status === "pending"
# - Response has "data.payment" object (untuk transfer)
# - data.payment.bank_name === "BRI"
# - data.payment.virtual_account ada (nomor rekening)
# - Response has "data.whatsapp" object (message & url untuk WhatsApp)
# - data.payment.expired_at ada (10 menit dari sekarang)

# 📝 RESPONSE akan berisi:
# {
#   "success": true,
#   "message": "Order berhasil dibuat",
#   "data": {
#     "order_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",  ← COPY UUID INI!
#     "order_number": "ORD-20241120-001",
#     ...
#   }
# }
#
# ✅ PASTE order_id ke @orderId di line 27:
# @orderId = a1b2c3d4-e5f6-7890-abcd-ef1234567890

###

### TEST 1.2: Checkout - Self Pickup dengan Cash
# Expected: 201 Created
POST {{baseUrl}}/api/customer/orders/create
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "customer_name": "Siti Nurhaliza",
  "customer_phone": "081234567891",
  "delivery_method": "self_pickup",
  "payment_method": "cash",
  "items": [
    {
