###############################################
# ⏱️ TEST GROUP 5: PAYMENT EXPIRY (Auto Cancel)
###############################################

### TEST 5.1: Order - Payment Expired After 10 Minutes
# Expected: Order status jadi "cancelled" setelah 10 menit
# MANUAL TEST:
# 1. Buat order dengan payment_method "transfer"
# 2. Tunggu 10 menit
# 3. Cron job auto-cancel order (orderAutoCancelCron.js)
# 4. GET order detail
# 5. Verify: order_status === "cancelled"
# 6. Verify: stock produk kembali (dikembalikan)

###

### TEST 5.2: Check Payment Expired At Field
# Expected: payment_expired_at = created_at + 10 menit
GET {{baseUrl}}/api/customer/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - order.payment_expired_at ada
# - payment_expired_at = created_at + 10 menit
# - Format: ISO 8601 (WIB timezone)

###

