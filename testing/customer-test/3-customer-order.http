# 📋 TEST GROUP 3: ORDER HISTORY (Riwayat Order)
###############################################

### TEST 3.1: Get Order History - All Orders
# Expected: 200 OK, list semua order customer
GET {{baseUrl}}/api/customer/orders/history
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Response has "data.orders" array (bukan langsung orders!)
# - Response has "data.pagination" object
# - Setiap order punya: order_number, order_status, total_amount, created_at
# - Orders sorted by created_at DESC (terbaru di atas)

###

### TEST 3.2: Get Order History - With Pagination
# Expected: 200 OK, paginated results
GET {{baseUrl}}/api/customer/orders/history?page=1&limit=10
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - Status: 200
# - orders.length <= 10
# - Response has pagination object

###

### TEST 3.3: Get Order History - Filter by Status
# Expected: 200 OK, filtered orders
GET {{baseUrl}}/api/customer/orders/history?status=pending
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders punya status "pending"

###

### TEST 3.4: Get Order History - Tanpa Token
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/customer/orders/history
Content-Type: application/json

# ✅ Assertions:
# - Status: 401

###

