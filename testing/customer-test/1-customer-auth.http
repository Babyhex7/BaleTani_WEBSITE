###############################################
# 📝 TEST GROUP 1: REGISTRASI CUSTOMER - HAPPY PATH
###############################################

### TEST 1.1: Registrasi Customer Baru - Sukses (Format HP: 08xxx)
# Expected: 201 Created, return token + customer data
# Nomor HP akan otomatis dinormalisasi ke format 628xxx
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "0817266272",
  "full_name": "Budi Santosa",
  "password": "password123",
  "address": "Jl. Merdeka No. 45, Jakarta Pusat"
}

# ✅ Assertions:
# - Status: 201
# - Response has "success": true
# - Response has "token" (JWT)
# - Response has "customer" object
# - customer.phone_number === "6281234567890" (normalized)
# - customer.full_name === "Budi Santoso"
# - customer.address === "Jl. Merdeka No. 45, Jakarta Pusat"
# - Password TIDAK muncul di response

###

### TEST 1.2: Registrasi Customer - Format HP 628xxx (Sudah Normalized)
# Expected: 201 Created
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "6281234567891",
  "full_name": "Siti Nurhaliza",
  "password": "sitinur123",
  "address": "Jl. Sudirman No. 10, Bandung"
}

# ✅ Assertions:
# - Status: 201
# - phone_number tetap "6281234567891"

###

### TEST 1.3: Registrasi Customer - Tanpa Address (Optional)
# Expected: 201 Created, address = null
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "081234567892",
  "full_name": "Ahmad Hidayat",
  "password": "ahmad123"
}

# ✅ Assertions:
# - Status: 201
# - customer.address === null atau tidak ada

###

### TEST 1.4: Registrasi Customer - Format HP +628xxx
# Expected: 201 Created, HP dinormalisasi ke 628xxx
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "+6281234567893",
  "full_name": "Dewi Lestari",
  "password": "dewi123",
  "address": "Jl. Gatot Subroto, Surabaya"
}

# ✅ Assertions:
# - Status: 201
# - phone_number === "6281234567893" (tanpa + dan spasi)

###

###############################################
# ❌ TEST GROUP 2: REGISTRASI - VALIDASI ERROR
###############################################

### TEST 2.1: Registrasi Gagal - Phone Number Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "",
  "full_name": "Test User",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon, nama lengkap, dan password wajib diisi"

###

### TEST 2.2: Registrasi Gagal - Nama Lengkap Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "081234567894",
  "full_name": "",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon, nama lengkap, dan password wajib diisi"

###

### TEST 2.3: Registrasi Gagal - Password Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "081234567895",
  "full_name": "Test User",
  "password": ""
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon, nama lengkap, dan password wajib diisi"

###

### TEST 2.4: Registrasi Gagal - Nomor HP Sudah Terdaftar (Duplicate)
# Expected: 400 Bad Request
# CATATAN: Gunakan nomor HP yang sudah diregistrasi di TEST 1.1
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "081234567890",
  "full_name": "User Lain",
  "password": "password456"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon sudah terdaftar"

###

### TEST 2.5: Registrasi Gagal - Password Terlalu Pendek (< 6 karakter)
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "081234567896",
  "full_name": "Test User",
  "password": "12345"
}

# ✅ Assertions:
# - Status: 400
# - Error message tentang password terlalu pendek

###

### TEST 2.6: Registrasi Gagal - Format HP Invalid (Kurang dari 10 digit)
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "0812345",
  "full_name": "Test User",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 400
# - Error message tentang format nomor HP invalid

###

###############################################
# 🔐 TEST GROUP 3: LOGIN CUSTOMER - HAPPY PATH
###############################################

### TEST 3.1: Login Customer - Sukses (Format 08xxx)
# Expected: 200 OK, return token + customer data
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Response has "token" (JWT)
# - Response has "customer" object
# - customer.phone_number === "6281234567890"
# - customer.full_name === "Budi Santoso"
# - Password TIDAK muncul di response

# 📝 SIMPAN TOKEN untuk test berikutnya:
# @customerToken = <copy token dari response>

###

### TEST 3.2: Login Customer - Format HP 628xxx (Normalized)
# Expected: 200 OK
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "6281234567890",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 200
# - Bisa login dengan format 628xxx

###

### TEST 3.3: Login Customer - Format HP +628xxx
# Expected: 200 OK
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "+6281234567890",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 200
# - Normalisasi HP otomatis di backend

###

###############################################
# ❌ TEST GROUP 4: LOGIN - VALIDASI ERROR
###############################################

### TEST 4.1: Login Gagal - Nomor HP Tidak Terdaftar
# Expected: 401 Unauthorized
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "089999999999",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 401
# - Error message: "Nomor telepon atau password salah"

###

### TEST 4.2: Login Gagal - Password Salah
# Expected: 401 Unauthorized
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890",
  "password": "passwordSalah"
}

# ✅ Assertions:
# - Status: 401
# - Error message: "Nomor telepon atau password salah"

###

### TEST 4.3: Login Gagal - Phone Number Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon dan password wajib diisi"

###

### TEST 4.4: Login Gagal - Password Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890",
  "password": ""
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon dan password wajib diisi"

###

### TEST 4.5: Login Gagal - SQL Injection Attempt
# Expected: 401 Unauthorized (tidak 500)
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890' OR '1'='1",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 401 (bukan 500)
# - Input di-sanitize dengan benar
# - Tidak ada error database

###

###############################################
# 🔒 TEST GROUP 5: PROTECTED ROUTES (Perlu Token)
###############################################

### TEST 5.1: Akses Profile - Dengan Token Valid
# Expected: 200 OK
# CATATAN: Ganti {{customerToken}} dengan token dari TEST 3.1
GET {{baseUrl}}/api/customer/profile
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - Status: 200
# - Response has customer data
# - customer.phone_number ada
# - customer.full_name ada
# - Password TIDAK ada di response

###

### TEST 5.2: Akses Profile - Tanpa Token
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/customer/profile
Content-Type: application/json

# ✅ Assertions:
# - Status: 401
# - Error message: "No token provided" atau "Token tidak ditemukan"

###

### TEST 5.3: Akses Profile - Token Invalid
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/customer/profile
Content-Type: application/json
Authorization: Bearer invalid_token_123456

# ✅ Assertions:
# - Status: 401
# - Error message: "Invalid token" atau "Token tidak valid"

###

### TEST 5.4: Akses Profile - Token Expired
# Expected: 401 Unauthorized
# CATATAN: Gunakan token yang sudah expired (>24 jam)
GET {{baseUrl}}/api/customer/profile
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.expiredtoken

# ✅ Assertions:
# - Status: 401
# - Error message: "Token expired" atau "Token kadaluwarsa"

###

###############################################
# 🔐 TEST GROUP 6: TOKEN SECURITY
###############################################

### TEST 6.1: Token JWT - Harus Berisi userId dan type
# Expected: Token payload harus ada userId, phone_number, type: "customer"
# MANUAL CHECK: Decode JWT token dari TEST 3.1 di https://jwt.io
# Payload harus seperti:
# {
#   "userId": "uuid-customer-id",
#   "phone_number": "6281234567890",
#   "type": "customer",
#   "iat": 1234567890,
#   "exp": 1234567890
# }

###

### TEST 6.2: Token Customer - Tidak Bisa Akses Admin Routes
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{customerToken}}

# ✅ Assertions:
# - Status: 403 Forbidden
# - Error message: "Access denied" atau "Akses ditolak"

###

###############################################
# 🔄 TEST GROUP 7: RATE LIMITING (Anti Brute Force)
###############################################

### TEST 7.1: Login Berulang - Cek Rate Limit
# Expected: Setelah 5x gagal, kena rate limit (429 Too Many Requests)
# MANUAL: Jalankan login gagal ini 6x berturut-turut

POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "081234567890",
  "password": "passwordSalah"
}

# ✅ Assertions (setelah 6x request):
# - Request 1-5: Status 401 (password salah)
# - Request 6: Status 429 (Too Many Requests)
# - Error message: "Too many login attempts" atau "Terlalu banyak percobaan login"

###

###############################################
# 📊 SUMMARY OF TESTS
###############################################

# ✅ TOTAL TESTS: 30+
# 
# Happy Path Tests: 7 (registrasi + login sukses)
# Validation Error Tests: 10 (input kosong, format salah, duplicate)
# Authentication Tests: 7 (token valid/invalid/expired)
# Security Tests: 3 (SQL injection, rate limiting, authorization)
#
# Expected Results:
# - Registrasi sukses: 201 Created + token
# - Login sukses: 200 OK + token
# - Validasi gagal: 400 Bad Request
# - Auth gagal: 401 Unauthorized
# - Access denied: 403 Forbidden
# - Rate limit: 429 Too Many Requests
# - No 500 errors (server handle gracefully)

###############################################
# 📝 MANUAL VERIFICATION CHECKLIST
###############################################

# Setelah running tests, verify:
# ✅ Customer baru bisa registrasi dengan nomor HP
# ✅ Customer bisa login dengan nomor HP + password
# ✅ Normalisasi HP otomatis (08xxx → 628xxx)
# ✅ Token JWT valid dan berisi userId + type
# ✅ Password di-hash di database (tidak plain text)
# ✅ Password TIDAK muncul di response API
# ✅ Protected routes butuh token
# ✅ Customer token tidak bisa akses admin routes
# ✅ Rate limiting berfungsi setelah 5x percobaan gagal
# ✅ SQL injection di-block

###############################################
# 🎯 CARA MENGGUNAKAN FILE INI
###############################################

# 1. Install VS Code Extension: "REST Client"
# 2. Pastikan backend running di http://localhost:5000
# 3. Pastikan database baletani_db sudah setup
# 4. Klik "Send Request" di atas setiap ### untuk test
# 5. Verify response sesuai dengan assertions
# 6. Simpan token dari TEST 3.1 untuk test berikutnya
# 7. Update @customerToken di line 7 dengan token yang didapat

###############################################
# 🚨 IMPORTANT NOTES
###############################################

# ⚠️ LOGIN PAKAI NOMOR HP (phone_number), BUKAN EMAIL!
# ⚠️ Format HP otomatis dinormalisasi ke 628xxx di backend
# ⚠️ Token expired setelah 24 jam
# ⚠️ Rate limit: Max 5 percobaan login dalam 15 menit
# ⚠️ Password minimal 6 karakter
# ⚠️ Setelah test, hapus data dummy di database jika perlu

