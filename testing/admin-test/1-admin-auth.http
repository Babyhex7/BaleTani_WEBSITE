###############################################
# 📝 TEST GROUP 1: LOGIN ADMIN - HAPPY PATH
###############################################

### TEST 1.1: Login Super Admin - Sukses (Full Access)
# Expected: 200 OK, return token + admin data with role
# KREDENSIAL YANG BENAR: 6282111111111 / admin123
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json



{
  "phone_number": "6282111111111",
  "password": "admin123"
}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Response has "token" (JWT)
# - Response has "admin" object
# - admin.phone_number === "6281111111111" (normalized)
# - admin.role.role_name === "super_admin"
# - admin.permissions array ada (list semua permissions)
# - Password TIDAK muncul di response

# 📝 SIMPAN TOKEN untuk test berikutnya:
# @superAdminToken = <copy token dari response>

###

### TEST 1.2: Login Kasir - Sukses (Limited Access)
# Expected: 200 OK, role = "cashier"
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081222222222",
  "password": "kasir123"
}

# ✅ Assertions:
# - Status: 200
# - admin.role.role_name === "cashier" atau "super_cashier"
# - admin.permissions array berisi permissions terbatas
# - Kasir TIDAK punya permission: "manage_users", "manage_roles"

# 📝 SIMPAN TOKEN:
# @kasirToken = <copy token dari response>

###

