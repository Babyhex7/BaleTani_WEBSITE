###############################################
# ❌ TEST GROUP 2: LOGIN - VALIDASI ERROR
###############################################

### TEST 2.1: Login Gagal - Phone Number Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon dan password wajib diisi"

###

### TEST 2.2: Login Gagal - Password Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111",
  "password": ""
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nomor telepon dan password wajib diisi"

###

### TEST 2.3: Login Gagal - Phone Number Tidak Terdaftar
# Expected: 401 Unauthorized
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "089999999999",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 401
# - Error message: "Nomor telepon atau password salah"

###

### TEST 2.4: Login Gagal - Password Salah
# Expected: 401 Unauthorized
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111",
  "password": "passwordSalah"
}

# ✅ Assertions:
# - Status: 401
# - Error message: "Nomor telepon atau password salah"

###

### TEST 2.5: Login Gagal - Admin Inactive (is_active = false)
# Expected: 401 Unauthorized
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "INACTIVE_ADMIN_PHONE",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 401
# - Error message: "Nomor telepon atau password salah" (tidak kasih tahu admin inactive)

###

### TEST 2.6: Login Gagal - SQL Injection Attempt
# Expected: 401 Unauthorized (tidak 500)
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111' OR '1'='1",
  "password": "password123"
}

# ✅ Assertions:
# - Status: 401 (bukan 500)
# - Input di-sanitize dengan benar

###

###############################################
# 🔒 TEST GROUP 3: ROLE-BASED ACCESS CONTROL (RBAC)
###############################################

### TEST 3.1: Super Admin - Akses Semua Endpoint (Full Access)
# Expected: 200 OK untuk semua endpoint
GET {{baseUrl}}/api/admin/users
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

# ✅ Assertions:
# - Status: 200
# - Super Admin bisa akses User Management

###

GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

# ✅ Assertions:
# - Status: 200
# - Super Admin bisa akses Product Management

###

GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

# ✅ Assertions:
# - Status: 200
# - Super Admin bisa akses Order Management

###

### TEST 3.2: Kasir - Akses Order Management (Allowed)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

# ✅ Assertions:
# - Status: 200
# - Kasir bisa lihat orders

###

### TEST 3.3: Kasir - Akses User Management (FORBIDDEN)
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/users
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

# ✅ Assertions:
# - Status: 403 Forbidden
# - Error message: "Anda tidak memiliki akses" atau "Forbidden"
# - Kasir TIDAK boleh akses user management

###

### TEST 3.4: Kasir - Akses Product Management (FORBIDDEN)
# Expected: 403 Forbidden (tergantung permission)
GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

# ✅ Assertions:
# - Status: 403 (jika kasir tidak punya permission manage_products)
# - Atau 200 jika kasir punya read permission

###

### TEST 3.5: WhatsApp Admin - Akses Contact Messages (Allowed)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/contacts
Content-Type: application/json
Authorization: Bearer WHATSAPP_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 200
# - WA Admin bisa manage contact messages

###

### TEST 3.6: WhatsApp Admin - Akses Financial Reports (FORBIDDEN)
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/reports/financial
Content-Type: application/json
Authorization: Bearer WHATSAPP_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 403
# - WA Admin tidak bisa akses financial reports

###

### TEST 3.7: Inventory Admin - Akses Products (Allowed)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer INVENTORY_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 200
# - Inventory Admin bisa manage products

###

### TEST 3.8: Inventory Admin - Akses User Management (FORBIDDEN)
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/users
Content-Type: application/json
Authorization: Bearer INVENTORY_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 403

###

### TEST 3.9: Finance Admin - Akses Reports (Allowed)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/reports/sales
Content-Type: application/json
Authorization: Bearer FINANCE_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 200
# - Finance Admin bisa akses reports

###

### TEST 3.10: Finance Admin - Akses User Management (FORBIDDEN)
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/users
Content-Type: application/json
Authorization: Bearer FINANCE_ADMIN_TOKEN

# ✅ Assertions:
# - Status: 403

###

###############################################
# 🚫 TEST GROUP 4: CROSS-AUTHENTICATION (Customer vs Admin)
###############################################

### TEST 4.1: Customer Token - Tidak Bisa Akses Admin Routes
# Expected: 403 Forbidden
GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer CUSTOMER_TOKEN_HERE

# ✅ Assertions:
# - Status: 403 Forbidden
# - Error message: "Access denied" atau "Admin access required"

###

### TEST 4.2: Admin Token - Tidak Bisa Akses Customer Routes
# Expected: 403 Forbidden atau 401
GET {{baseUrl}}/api/customer/cart
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 403 or 401
# - Admin token tidak berlaku untuk customer routes

###

###############################################
# 🔐 TEST GROUP 5: TOKEN SECURITY
###############################################

### TEST 5.1: Token JWT - Harus Berisi userId, role, permissions
# Expected: Token payload lengkap
# MANUAL CHECK: Decode JWT token dari TEST 1.1 di https://jwt.io
# Payload harus seperti:
# {
#   "userId": "uuid-admin-id",
#   "phone_number": "6281111111111",
#   "role": "super_admin",
#   "roleId": "uuid-role-id",
#   "type": "admin",
#   "iat": 1234567890,
#   "exp": 1234567890
# }

###

### TEST 5.2: Akses Admin Route - Tanpa Token
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/admin/dashboard/stats
Content-Type: application/json

# ✅ Assertions:
# - Status: 401
# - Error message: "Token tidak ditemukan" atau "No token provided"

###

### TEST 5.3: Akses Admin Route - Token Invalid
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/admin/dashboard/stats
Content-Type: application/json
Authorization: Bearer invalid_token_123456

# ✅ Assertions:
# - Status: 401
# - Error message: "Token tidak valid" atau "Invalid token"

###

### TEST 5.4: Akses Admin Route - Token Expired
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/admin/dashboard/stats
Content-Type: application/json
Authorization: Bearer EXPIRED_TOKEN_HERE

# ✅ Assertions:
# - Status: 401
# - Error message: "Token kadaluwarsa" atau "Token expired"

###

###############################################
# 🔄 TEST GROUP 6: RATE LIMITING (Anti Brute Force)
###############################################

### TEST 6.1: Login Berulang - Cek Rate Limit
# Expected: Setelah 5x gagal, kena rate limit (429 Too Many Requests)
# MANUAL: Jalankan login gagal ini 6x berturut-turut

POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111",
  "password": "passwordSalah"
}

# ✅ Assertions (setelah 6x request):
# - Request 1-5: Status 401 (password salah)
# - Request 6: Status 429 (Too Many Requests)
# - Error message: "Terlalu banyak percobaan login"

###

