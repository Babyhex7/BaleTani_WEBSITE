###############################################
# 🛍️ TEST SUITE: ADMIN ORDER MANAGEMENT
# File: 3-admin-orders.http
# Deskripsi: Test lengkap untuk manage orders oleh admin
# PENTING: Perlu token admin dengan permission "manage_orders"!
###############################################

@baseUrl = http://localhost:5000
@adminToken = YOUR_ADMIN_TOKEN_HERE
@orderId = YOUR_ORDER_ID_HERE
@customerId = YOUR_CUSTOMER_ID_HERE
@productId = YOUR_PRODUCT_ID_HERE

###############################################
# ⚠️ SETUP: Login Admin Dulu!
###############################################

### STEP 0: Login Admin (Super Admin / Kasir / WA Admin)
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111",
  "password": "superadmin123"
}

# 📝 COPY token dari response dan paste ke @adminToken!

###

###############################################
# 📋 TEST GROUP 1: GET ORDERS (Read All)
###############################################

### TEST 1.1: Get All Orders - Default Pagination
# Expected: 200 OK, list orders dengan pagination
GET {{baseUrl}}/api/admin/orders?page=1&limit=10
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Response has "data" object
# - data.orders array
# - data.pagination object
# - Setiap order punya: order_number, customer_name, total_price, order_status, created_at

###

### TEST 1.2: Get Orders - Search by Order Number
# Expected: 200 OK, filtered orders
GET {{baseUrl}}/api/admin/orders?search=ORD-20251120
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Orders dengan order_number contain search term

###

### TEST 1.3: Get Orders - Search by Customer Name
# Expected: 200 OK, filtered orders
GET {{baseUrl}}/api/admin/orders?search=Budi
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Orders dengan customer_name contain "Budi"

###

### TEST 1.4: Get Orders - Filter by Order Status (Pending)
# Expected: 200 OK, only pending orders
GET {{baseUrl}}/api/admin/orders?order_status=pending
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.order_status === "pending"

###

### TEST 1.5: Get Orders - Filter by Order Status (Processing)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?order_status=processing
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.order_status === "processing"

###

### TEST 1.6: Get Orders - Filter by Payment Status
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?payment_status=pending
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.payment_status === "pending"

###

### TEST 1.7: Get Orders - Filter by Payment Method
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?payment_method=transfer
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.payment_method === "transfer"

###

### TEST 1.8: Get Orders - Filter by Delivery Method
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?delivery_method=delivery
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.delivery_method === "delivery"

###

### TEST 1.9: Get Orders - Filter by Order Type (Online)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?order_type=online
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.transaction_type === "online"

###

### TEST 1.10: Get Orders - Filter by Order Type (Offline)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?order_type=offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.transaction_type === "offline"

###

### TEST 1.11: Get Orders - Filter by Date Range
# Expected: 200 OK, orders within date range
GET {{baseUrl}}/api/admin/orders?date_from=2025-11-01&date_to=2025-11-30
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua orders.created_at between date_from and date_to

###

### TEST 1.12: Get Orders - Sort by Total Price DESC
# Expected: 200 OK, sorted by price
GET {{baseUrl}}/api/admin/orders?sort_by=total_price&sort_order=DESC
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - orders[0].total_price >= orders[1].total_price

###

### TEST 1.13: Get Orders - Combined Filters
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders?order_status=pending&payment_method=transfer&date_from=2025-11-01
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Orders match all filter criteria

###

###############################################
# 🔍 TEST GROUP 2: GET ORDER DETAIL
###############################################

### TEST 2.1: Get Order Detail - Valid Order ID
# Expected: 200 OK, complete order details
GET {{baseUrl}}/api/admin/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has order object dengan:
#   - order_number, customer_name, customer_phone
#   - order_status, payment_status, payment_method
#   - delivery_method, delivery_address
#   - items array (product details, qty, price)
#   - payment object (bank_name, payment_proof)
#   - status_history array (timeline perubahan status)
#   - total_price, discount, final_price

###

### TEST 2.2: Get Order Detail - Invalid Order ID
# Expected: 404 Not Found
GET {{baseUrl}}/api/admin/orders/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 404
# - Error message: "Order tidak ditemukan"

###

### TEST 2.3: Get Order Detail - Invalid UUID Format
# Expected: 400 Bad Request
GET {{baseUrl}}/api/admin/orders/invalid-uuid
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 400
# - Error message: "Format Order ID tidak valid"

###

###############################################
# ✏️ TEST GROUP 3: UPDATE ORDER STATUS
###############################################

### TEST 3.1: Update Status - Pending → Processing (Super Admin)
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "processing",
  "notes": "Order sedang diproses oleh admin"
}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - order.order_status === "processing"
# - Status history tercatat

###

### TEST 3.2: Update Status - Processing → Shipped
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "shipped",
  "notes": "Pesanan sudah dikirim via JNE"
}

# ✅ Assertions:
# - Status: 200
# - order.order_status === "shipped"

###

### TEST 3.3: Update Status - Shipped → Delivered
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "delivered",
  "notes": "Pesanan telah diterima customer"
}

# ✅ Assertions:
# - Status: 200
# - order.order_status === "delivered"

###

### TEST 3.4: Update Status - Pending → Cancelled
# Expected: 200 OK, stock dikembalikan
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "cancelled",
  "notes": "Order dibatalkan oleh admin karena customer tidak konfirmasi"
}

# ✅ Assertions:
# - Status: 200
# - order.order_status === "cancelled"
# - Stock produk kembali

###

### TEST 3.5: Update Status Gagal - Status Invalid
# Expected: 400 Bad Request
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "invalid_status",
  "notes": "Test invalid status"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Status order tidak valid"

###

### TEST 3.6: Update Status Gagal - Order ID Tidak Ada
# Expected: 404 Not Found
PUT {{baseUrl}}/api/admin/orders/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "processing",
  "notes": "Test"
}

# ✅ Assertions:
# - Status: 404

###

### TEST 3.7: Update Status Gagal - Kasir Update ke Delivered (Permission Denied)
# Expected: 403 Forbidden (tergantung role permission)
# CATATAN: Gunakan token kasir biasa (bukan super_cashier)
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

{
  "order_status": "delivered",
  "notes": "Kasir biasa tidak boleh mark as delivered"
}

# ✅ Assertions:
# - Status: 403
# - Error message: "Anda tidak memiliki akses untuk mengubah status ini"

###

###############################################
# 💳 TEST GROUP 4: UPDATE PAYMENT STATUS
###############################################

### TEST 4.1: Update Payment Status - Pending → Paid
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/payment
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "payment_status": "paid",
  "notes": "Pembayaran sudah dikonfirmasi via transfer BRI"
}

# ✅ Assertions:
# - Status: 200
# - payment.payment_status === "paid"
# - order.payment_status === "paid"

###

### TEST 4.2: Update Payment Status - Pending → Failed
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/payment
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "payment_status": "failed",
  "notes": "Bukti transfer tidak valid"
}

# ✅ Assertions:
# - Status: 200
# - payment.payment_status === "failed"

###

### TEST 4.3: Update Payment Status Gagal - Status Invalid
# Expected: 400 Bad Request
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/payment
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "payment_status": "invalid_status",
  "notes": "Test"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Status pembayaran tidak valid"

###

###############################################
# 📦 TEST GROUP 5: CREATE OFFLINE ORDER
###############################################

### TEST 5.1: Create Offline Order - Sukses
# Expected: 201 Created
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer_name": "Walk-in Customer",
  "customer_phone": "081234567890",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": [
    {
      "product_id": "{{productId}}",
      "quantity": 2
    }
  ],
  "notes": "Pembeli langsung datang ke toko"
}

# ✅ Assertions:
# - Status: 201
# - Response has "order" object
# - order.transaction_type === "offline"
# - order.order_status === "completed" (langsung selesai)
# - order.payment_status === "paid" (cash langsung lunas)

###

### TEST 5.2: Create Offline Order - Multiple Items
# Expected: 201 Created
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer_name": "Toko Sayur Pak Slamet",
  "customer_phone": "081234567891",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": [
    {
      "product_id": "{{productId}}",
      "quantity": 5
    },
    {
      "product_id": "ANOTHER_PRODUCT_ID",
      "quantity": 3
    }
  ],
  "notes": "Pelanggan tetap, ambil langsung"
}

# ✅ Assertions:
# - Status: 201
# - order.items.length === 2

###

### TEST 5.3: Create Offline Order Gagal - Customer Name Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer_name": "",
  "customer_phone": "081234567890",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": [
    {
      "product_id": "{{productId}}",
      "quantity": 1
    }
  ]
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nama customer wajib diisi"

###

### TEST 5.4: Create Offline Order Gagal - Items Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer_name": "Test Customer",
  "customer_phone": "081234567890",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": []
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Items tidak boleh kosong"

###

### TEST 5.5: Create Offline Order Gagal - Stock Tidak Cukup
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "customer_name": "Test Customer",
  "customer_phone": "081234567890",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": [
    {
      "product_id": "{{productId}}",
      "quantity": 999999
    }
  ]
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Stok tidak mencukupi"

###

### TEST 5.6: Create Offline Order Gagal - Tanpa Permission
# Expected: 403 Forbidden
# CATATAN: Gunakan token role yang tidak punya permission "create_offline_order"
POST {{baseUrl}}/api/admin/orders/offline
Content-Type: application/json
Authorization: Bearer {{noPermissionToken}}

{
  "customer_name": "Test Customer",
  "customer_phone": "081234567890",
  "payment_method": "cash",
  "delivery_method": "self_pickup",
  "items": [
    {
      "product_id": "{{productId}}",
      "quantity": 1
    }
  ]
}

# ✅ Assertions:
# - Status: 403

###

###############################################
# 📊 TEST GROUP 6: ORDER STATISTICS & SUMMARY
###############################################

### TEST 6.1: Get Order Statistics - By Status
# Expected: 200 OK, summary per status
GET {{baseUrl}}/api/admin/orders/stats/by-status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has counts for each status:
#   - pending, processing, shipped, delivered, cancelled

###

### TEST 6.2: Get Today's Orders Count
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders/stats/today
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has:
#   - total_orders (count)
#   - total_revenue (sum)
#   - online_orders, offline_orders

###

### TEST 6.3: Get Orders Summary - This Month
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders/stats/month
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has monthly statistics

###

###############################################
# 🔒 TEST GROUP 7: ROLE-BASED ACCESS
###############################################

### TEST 7.1: Super Admin - Full Access to All Orders
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{superAdminToken}}

# ✅ Assertions:
# - Status: 200
# - Super Admin bisa lihat semua orders

###

### TEST 7.2: Kasir - Read Orders (Allowed)
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

# ✅ Assertions:
# - Status: 200
# - Kasir bisa view orders

###

### TEST 7.3: Kasir - Update Order Status (Limited Access)
# Expected: 200 OK untuk status tertentu, 403 untuk status lainnya
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

{
  "order_status": "processing",
  "notes": "Kasir update ke processing"
}

# ✅ Assertions:
# - Status: 200 (kasir bisa update ke processing)
# - Tapi tidak bisa update ke "delivered" atau "cancelled" (403)

###

### TEST 7.4: WA Admin - Full Access to Orders
# Expected: 200 OK
GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{waAdminToken}}

# ✅ Assertions:
# - Status: 200
# - WA Admin bisa manage orders

###

###############################################
# 📊 SUMMARY OF TESTS
###############################################

# ✅ TOTAL TESTS: 40+
# 
# Get Orders: 13 tests (filters, search, pagination)
# Get Order Detail: 3 tests
# Update Order Status: 7 tests
# Update Payment Status: 3 tests
# Create Offline Order: 6 tests
# Order Statistics: 3 tests
# Role-Based Access: 4 tests
#
# Expected Results:
# - Get orders sukses: 200 OK
# - Create offline order: 201 Created
# - Update status sukses: 200 OK
# - Validasi gagal: 400 Bad Request
# - Order tidak ditemukan: 404 Not Found
# - Tanpa permission: 403 Forbidden
# - No 500 errors

###############################################
# 📝 MANUAL VERIFICATION CHECKLIST
###############################################

# Setelah running tests, verify:
# ✅ Admin bisa view all orders dengan filters
# ✅ Admin bisa update order status (dengan permission)
# ✅ Admin bisa update payment status
# ✅ Admin bisa create offline orders
# ✅ Status history tercatat setiap perubahan
# ✅ Stock dikembalikan saat order cancelled
# ✅ RBAC: Kasir punya limited access
# ✅ Super Admin full access
# ✅ Offline orders langsung completed & paid
# ✅ Order statistics akurat

###############################################
# 🎯 CARA MENGGUNAKAN FILE INI
###############################################

# 1. Login admin dulu (STEP 0)
# 2. Copy token ke @adminToken
# 3. Buat order dulu (via customer atau offline)
# 4. Simpan order_id
# 5. Jalankan test get, update, stats
# 6. Verify di database & frontend

###############################################
# 🚨 IMPORTANT NOTES
###############################################

# ⚠️ Perlu permission "manage_orders" untuk update
# ⚠️ Perlu permission "create_offline_order" untuk create offline
# ⚠️ Order status flow: pending → processing → shipped → delivered
# ⚠️ Cancelled order: stock dikembalikan
# ⚠️ Offline order: langsung completed & paid
# ⚠️ Status history tercatat di order_status_history table
# ⚠️ RBAC: Kasir limited access, Super Admin full access
# ⚠️ Payment expiry: 10 menit untuk online orders

###
