###############################################
# 📦 TEST SUITE: ADMIN PRODUCT MANAGEMENT
# File: 2-admin-products.http
# Deskripsi: Test lengkap untuk CRUD products oleh admin
# PENTING: Perlu token admin dengan permission "manage_products"!
###############################################

@baseUrl = http://localhost:5000
@adminToken = YOUR_ADMIN_TOKEN_HERE
@productId = YOUR_PRODUCT_ID_HERE
@categoryId = YOUR_CATEGORY_ID_HERE

###############################################
# ⚠️ SETUP: Login Admin Dulu!
###############################################

### STEP 0: Login Admin (Super Admin / Inventory Admin)
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081111111111",
  "password": "superadmin123"
}

# 📝 COPY token dari response dan paste ke @adminToken di line 9!

###

###############################################
# 📋 TEST GROUP 1: GET PRODUCTS (Read)
###############################################

### TEST 1.1: Get All Products - Default Pagination
# Expected: 200 OK, list products dengan pagination
GET {{baseUrl}}/api/admin/products?page=1&limit=10
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Response has "data" object
# - data.products array
# - data.pagination object (page, limit, total, totalPages)
# - Setiap product punya: id, name, price, stock, category, images

###

### TEST 1.2: Get Products - Search by Name
# Expected: 200 OK, filtered products
GET {{baseUrl}}/api/admin/products?search=tomat
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua products.name contain "tomat" (case-insensitive)

###

### TEST 1.3: Get Products - Filter by Category
# Expected: 200 OK, products from specific category
GET {{baseUrl}}/api/admin/products?category_id={{categoryId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua products.category_id === categoryId

###

### TEST 1.4: Get Products - Filter by Product Type
# Expected: 200 OK, filtered by type
GET {{baseUrl}}/api/admin/products?product_type=ready_stock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua products.product_type === "ready_stock"

###

### TEST 1.5: Get Products - Filter by Active Status
# Expected: 200 OK, only active products
GET {{baseUrl}}/api/admin/products?is_active=true
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua products.is_active === true

###

### TEST 1.6: Get Products - Stock Below Threshold
# Expected: 200 OK, low stock products
GET {{baseUrl}}/api/admin/products?stock_below=10
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Semua products.total_stock < 10

###

### TEST 1.7: Get Products - Sort by Name ASC
# Expected: 200 OK, sorted alphabetically
GET {{baseUrl}}/api/admin/products?sort_by=name&sort_order=ASC
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Products sorted by name A-Z

###

### TEST 1.8: Get Products - Sort by Price DESC
# Expected: 200 OK, sorted by price high to low
GET {{baseUrl}}/api/admin/products?sort_by=selling_price&sort_order=DESC
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - products[0].selling_price >= products[1].selling_price

###

### TEST 1.9: Get Single Product Detail - Valid ID
# Expected: 200 OK, complete product detail
GET {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has product object dengan:
#   - id, name, description, sku, barcode
#   - selling_price, purchase_price, profit_margin
#   - total_stock, minimum_stock, quantity_info
#   - product_type, is_active
#   - category object
#   - images array
#   - discounts array (if any)

###

### TEST 1.10: Get Product Detail - Invalid ID
# Expected: 404 Not Found
GET {{baseUrl}}/api/admin/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 404
# - Error message: "Produk tidak ditemukan"

###

###############################################
# ➕ TEST GROUP 2: CREATE PRODUCT
###############################################

### TEST 2.1: Create Product - Sukses (Ready Stock)
# Expected: 201 Created
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Tomat Segar Organik",
  "description": "Tomat segar pilihan dari kebun organik, kualitas premium untuk masakan sehat",
  "sku": "TOM-ORG-001",
  "barcode": "1234567890123",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 25000,
  "purchase_price": 18000,
  "total_stock": 100,
  "minimum_stock": 10,
  "quantity_info": "1 kg",
  "is_active": true
}

# ✅ Assertions:
# - Status: 201
# - Response has "success": true
# - Response has "product" object
# - product.profit_margin terkalkulasi otomatis
# - product.created_at ada

# 📝 SIMPAN product.id untuk test berikutnya!

###

### TEST 2.2: Create Product - Pre-Order Type
# Expected: 201 Created
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Durian Monthong Premium",
  "description": "Durian Monthong impor Thailand, pre-order 3 hari",
  "sku": "DUR-MTH-001",
  "category_id": "{{categoryId}}",
  "product_type": "pre_order",
  "selling_price": 150000,
  "purchase_price": 120000,
  "total_stock": 0,
  "minimum_stock": 0,
  "quantity_info": "1 buah (2-3 kg)",
  "is_active": true
}

# ✅ Assertions:
# - Status: 201
# - product_type === "pre_order"
# - total_stock bisa 0 untuk pre-order

###

### TEST 2.3: Create Product - Minimal Data (Without Optional Fields)
# Expected: 201 Created
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Test Minimal",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 201
# - SKU auto-generated jika tidak diisi
# - minimum_stock default = 0
# - is_active default = true

###

### TEST 2.4: Create Product Gagal - Nama Kosong
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Nama produk wajib diisi"

###

### TEST 2.5: Create Product Gagal - Category ID Invalid
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Test",
  "category_id": "00000000-0000-0000-0000-000000000000",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Kategori tidak ditemukan"

###

### TEST 2.6: Create Product Gagal - Selling Price < 0
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Test",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": -5000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Harga jual harus positif"

###

### TEST 2.7: Create Product Gagal - Stock Negatif
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Test",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": -10
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Stok tidak boleh negatif"

###

### TEST 2.8: Create Product Gagal - SKU Duplicate
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Duplicate SKU",
  "sku": "TOM-ORG-001",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 400
# - Error message: "SKU sudah digunakan"

###

### TEST 2.9: Create Product Gagal - Tanpa Permission
# Expected: 403 Forbidden
# CATATAN: Gunakan token kasir yang tidak punya permission "manage_products"
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

{
  "name": "Produk Test",
  "category_id": "{{categoryId}}",
  "product_type": "ready_stock",
  "selling_price": 10000,
  "purchase_price": 8000,
  "total_stock": 50
}

# ✅ Assertions:
# - Status: 403
# - Error message: "Anda tidak memiliki akses"

###

###############################################
# ✏️ TEST GROUP 3: UPDATE PRODUCT
###############################################

### TEST 3.1: Update Product - Sukses (Partial Update)
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Tomat Segar Organik Premium (Updated)",
  "selling_price": 28000,
  "description": "Tomat organik dengan kualitas premium, langsung dari petani lokal"
}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - product.name updated
# - product.selling_price updated
# - Fields lain tidak berubah

###

### TEST 3.2: Update Product - Update Stock
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "total_stock": 150,
  "minimum_stock": 20
}

# ✅ Assertions:
# - Status: 200
# - product.total_stock === 150
# - product.minimum_stock === 20

###

### TEST 3.3: Update Product - Deactivate Product
# Expected: 200 OK
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "is_active": false
}

# ✅ Assertions:
# - Status: 200
# - product.is_active === false

###

### TEST 3.4: Update Product Gagal - Product ID Tidak Ada
# Expected: 404 Not Found
PUT {{baseUrl}}/api/admin/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Produk Updated"
}

# ✅ Assertions:
# - Status: 404
# - Error message: "Produk tidak ditemukan"

###

### TEST 3.5: Update Product Gagal - Selling Price Negatif
# Expected: 400 Bad Request
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "selling_price": -1000
}

# ✅ Assertions:
# - Status: 400
# - Error message: "Harga jual harus positif"

###

### TEST 3.6: Update Product Gagal - SKU Duplicate
# Expected: 400 Bad Request
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "sku": "EXISTING_SKU_FROM_ANOTHER_PRODUCT"
}

# ✅ Assertions:
# - Status: 400
# - Error message: "SKU sudah digunakan produk lain"

###

### TEST 3.7: Update Product Gagal - Tanpa Permission
# Expected: 403 Forbidden
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

{
  "name": "Updated by Kasir"
}

# ✅ Assertions:
# - Status: 403

###

###############################################
# 🗑️ TEST GROUP 4: DELETE PRODUCT (Soft Delete)
###############################################

### TEST 4.1: Soft Delete Product - Sukses
# Expected: 200 OK, product soft deleted
DELETE {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Response has "success": true
# - Message: "Produk berhasil dihapus"

###

### TEST 4.2: Verify Soft Delete - Product Tidak Muncul di List
# Expected: Product tidak ada di list
GET {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Product yang di-delete tidak ada di list

###

### TEST 4.3: Verify Soft Delete - Product Detail Return 404
# Expected: 404 Not Found
GET {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 404
# - Error message: "Produk tidak ditemukan"

###

### TEST 4.4: Delete Product Gagal - Product Tidak Ada
# Expected: 404 Not Found
DELETE {{baseUrl}}/api/admin/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 404

###

### TEST 4.5: Delete Product Gagal - Tanpa Permission
# Expected: 403 Forbidden
DELETE {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{kasirToken}}

# ✅ Assertions:
# - Status: 403

###

###############################################
# 🖼️ TEST GROUP 5: PRODUCT IMAGES
###############################################

### TEST 5.1: Upload Product Image - Sukses
# Expected: 201 Created
# CATATAN: Gunakan form-data, bukan JSON
POST {{baseUrl}}/api/admin/products/{{productId}}/images
Content-Type: multipart/form-data
Authorization: Bearer {{adminToken}}

# Body (form-data):
# - image: (file) tomat.jpg
# - display_order: 1

# ✅ Assertions:
# - Status: 201
# - Response has image_url
# - Image tersimpan di /public/uploads/products/

###

### TEST 5.2: Upload Image Gagal - File Bukan Gambar
# Expected: 400 Bad Request
POST {{baseUrl}}/api/admin/products/{{productId}}/images
Content-Type: multipart/form-data
Authorization: Bearer {{adminToken}}

# Body (form-data):
# - image: (file) document.pdf

# ✅ Assertions:
# - Status: 400
# - Error message: "File harus berupa gambar (jpg, png, webp)"

###

### TEST 5.3: Upload Image Gagal - File Terlalu Besar (> 5MB)
# Expected: 413 Payload Too Large
POST {{baseUrl}}/api/admin/products/{{productId}}/images
Content-Type: multipart/form-data
Authorization: Bearer {{adminToken}}

# Body (form-data):
# - image: (file) large_image.jpg (10MB)

# ✅ Assertions:
# - Status: 413
# - Error message: "Ukuran file maksimal 5MB"

###

### TEST 5.4: Delete Product Image - Sukses
# Expected: 200 OK
DELETE {{baseUrl}}/api/admin/products/{{productId}}/images/{{imageId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

# ✅ Assertions:
# - Status: 200
# - Message: "Gambar berhasil dihapus"
# - File di server juga terhapus

###

###############################################
# 🔍 TEST GROUP 6: CACHE INVALIDATION
###############################################

### TEST 6.1: Cache Invalidation - After Create Product
# Expected: Cache products di-clear
# MANUAL TEST:
# 1. GET /api/public/products (cache hit)
# 2. POST /api/admin/products (create new)
# 3. GET /api/public/products lagi (cache miss, data fresh)

###

### TEST 6.2: Cache Invalidation - After Update Product
# Expected: Cache product detail di-clear
# MANUAL TEST:
# 1. GET /api/public/products/:id (cache hit)
# 2. PUT /api/admin/products/:id (update)
# 3. GET /api/public/products/:id lagi (cache miss, data updated)

###

### TEST 6.3: Cache Invalidation - After Delete Product
# Expected: Cache di-clear
# MANUAL TEST:
# 1. GET /api/public/products (product masih ada)
# 2. DELETE /api/admin/products/:id
# 3. GET /api/public/products (product tidak ada)

###

###############################################
# 📊 SUMMARY OF TESTS
###############################################

# ✅ TOTAL TESTS: 40+
# 
# Get Products: 10 tests
# Create Product: 9 tests
# Update Product: 7 tests
# Delete Product: 5 tests
# Product Images: 4 tests
# Cache Invalidation: 3 tests
#
# Expected Results:
# - Create/Update sukses: 200/201 OK
# - Validasi gagal: 400 Bad Request
# - Product tidak ditemukan: 404 Not Found
# - Tanpa permission: 403 Forbidden
# - No 500 errors

###############################################
# 📝 MANUAL VERIFICATION CHECKLIST
###############################################

# Setelah running tests, verify:
# ✅ Admin bisa CRUD products dengan permission
# ✅ Profit margin terkalkulasi otomatis
# ✅ Stock validation bekerja (tidak bisa negatif)
# ✅ SKU unique validation bekerja
# ✅ Soft delete berfungsi (data tetap di DB)
# ✅ Product images upload & delete bekerja
# ✅ File validation (tipe & ukuran) bekerja
# ✅ Cache invalidation setelah CRUD
# ✅ RBAC: Kasir tidak bisa create/update/delete
# ✅ Search & filter bekerja dengan benar

###############################################
# 🎯 CARA MENGGUNAKAN FILE INI
###############################################

# 1. Login admin dulu (STEP 0)
# 2. Copy token ke @adminToken
# 3. Ambil category_id dari database
# 4. Jalankan test create product (TEST 2.1)
# 5. Simpan product_id dari response
# 6. Jalankan test lainnya
# 7. Verify di database & frontend

###############################################
# 🚨 IMPORTANT NOTES
###############################################

# ⚠️ Perlu permission "manage_products" untuk create/update/delete
# ⚠️ Kasir hanya bisa read products (view_products)
# ⚠️ Profit margin = ((selling - purchase) / purchase) * 100
# ⚠️ Soft delete: data tidak hilang dari DB
# ⚠️ SKU auto-generated jika tidak diisi
# ⚠️ Image max 5MB, format: jpg, png, webp
# ⚠️ Cache auto-invalidate setelah CRUD
# ⚠️ Pre-order products bisa stock = 0

###
