### ================================================
### 🔐 ROLE LOGIN TEST - 8 ADMIN ROLES
### Testing apakah semua admin bisa login dengan role berbeda
### ================================================

@baseUrl = http://localhost:5000/api

### ================================================
### TEST 1: Super Admin
### ================================================
# @name login_super_admin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567808",
  "password": "admin123"
}

### Check response (harus ada token & role info)
### Expected: role.code = "super_admin"
### Expected: permissions array tidak kosong

###

### ================================================
### TEST 2: Kasir
### ================================================
# @name login_kasir
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567801",
  "password": "kasir123"
}

### Expected: role.code = "cashier"
### Expected: permissions untuk offline orders only

###

### ================================================
### TEST 3: WhatsApp Admin
### ================================================
# @name login_wa_admin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567802",
  "password": "wa123"
}

### Expected: role.code = "whatsapp_admin"
### Expected: permissions untuk online orders only

###

### ================================================
### TEST 4: Inventory Admin
### ================================================
# @name login_inventory_admin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567803",
  "password": "inventory123"
}

### Expected: role.code = "inventory_admin"
### Expected: permissions untuk procurement (draft only)

###

### ================================================
### TEST 5: Finance Admin
### ================================================
# @name login_finance_admin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567804",
  "password": "finance123"
}

### Expected: role.code = "finance_admin"
### Expected: permissions untuk view reports only

###

### ================================================
### TEST 6: Super Cashier
### ================================================
# @name login_super_cashier
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567805",
  "password": "supercashier123"
}

### Expected: role.code = "super_cashier"
### Expected: permissions untuk all orders (online & offline)

###

### ================================================
### TEST 7: Super Inventory Admin
### ================================================
# @name login_super_inventory
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567806",
  "password": "superinventory123"
}

### Expected: role.code = "super_inventory_admin"
### Expected: permissions untuk CRUD products & approve procurement

###

### ================================================
### TEST 8: Super WhatsApp Admin
### ================================================
# @name login_super_wa_admin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "phone_number": "081234567807",
  "password": "superwa123"
}

### Expected: role.code = "super_whatsapp_admin"
### Expected: permissions untuk all orders & customers

###

### ================================================
### 🔍 VERIFY - Get Current User Info
### ================================================

### Get Super Admin Profile
GET {{baseUrl}}/admin/auth/me
Authorization: Bearer {{login_super_admin.response.body.token}}

###

### Get Kasir Profile
GET {{baseUrl}}/admin/auth/me
Authorization: Bearer {{login_kasir.response.body.token}}

