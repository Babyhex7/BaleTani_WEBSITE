###############################################
# CUSTOMER CART API
# Endpoint: /api/customer/cart/*
# Authentication: Required (Customer Token)
###############################################

@baseUrl = http://localhost:5000

# Customer Credentials (untuk login di 2-customer-auth.http)
@customerPhone = 08123456789
@customerPassword = password123

# Paste token setelah login
@customerToken = paste-token-from-login

# Sample IDs (copy dari response)
@productId = paste-product-id-here
@cartItemId = paste-cart-item-id-here

###############################################
# CART OPERATIONS
###############################################

### 1. Get Cart (All items in cart)
GET {{baseUrl}}/api/customer/cart
Content-Type: application/json
Authorization: Bearer {{customerToken}}

### 2. Add Product to Cart
# Ganti @productId dengan ID produk yang valid dari 1-public-api.http
POST {{baseUrl}}/api/customer/cart/add
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "productId": "{{productId}}",
  "quantity": 2
}

### 3. Update Cart Item Quantity
# Ganti @cartItemId dengan ID item di cart
PUT {{baseUrl}}/api/customer/cart/{{cartItemId}}
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "quantity": 5
}

### 4. Remove Item from Cart
# Ganti @cartItemId dengan ID item yang mau dihapus
DELETE {{baseUrl}}/api/customer/cart/{{cartItemId}}
Authorization: Bearer {{customerToken}}

