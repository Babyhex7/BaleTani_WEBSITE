###############################################
# ADMIN AUTHENTICATION API
# Endpoint: /api/admin/auth/*
###############################################

@baseUrl = http://localhost:5000
@adminToken = paste-admin-token-here

# Default Admin Credentials (sudah ada dari seeder)
@adminEmail = admin@baletani.com
@adminPassword = admin123

###############################################
# ADMIN AUTHENTICATION
###############################################

### 1. Login Admin
# IMPORTANT: Copy token dari response dan paste ke @adminToken di atas
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 2. Get Admin Profile (Need Authentication)
GET {{baseUrl}}/api/admin/auth/profile
Content-Type: application/json
Authorization: Bearer {{adminToken}}

