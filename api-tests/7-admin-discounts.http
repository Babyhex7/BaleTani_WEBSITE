###############################################
# ADMIN DISCOUNT MANAGEMENT API
# Endpoint: /api/admin/discounts/*
# Authentication: Required (Admin Token)
###############################################

@baseUrl = http://localhost:5000

# Admin Credentials
@adminEmail = admin@baletani.com
@adminPassword = admin123

# Paste token setelah login di 4-admin-auth.http
@adminToken = paste-admin-token-here

# Sample ID
@discountId = paste-discount-id-here

###############################################
# DISCOUNT MANAGEMENT
###############################################

### 1. Get All Discounts
GET {{baseUrl}}/api/admin/discounts
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 2. Create New Discount
POST {{baseUrl}}/api/admin/discounts
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Diskon Ramadan 2025",
  "description": "Diskon spesial menyambut bulan suci Ramadan",
  "discount_type": "percentage",
  "value": 20,
  "start_date": "2025-03-01",
  "end_date": "2025-03-31"
}

### 3. Update Discount
PUT {{baseUrl}}/api/admin/discounts/{{discountId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Diskon Ramadan 2025 - Extended",
  "value": 25,
  "end_date": "2025-04-15"
}

### 4. Delete Discount
DELETE {{baseUrl}}/api/admin/discounts/{{discountId}}
Authorization: Bearer {{adminToken}}

