###############################################
# CUSTOMER AUTHENTICATION API
# Endpoint: /api/customer/auth/*
# PENTING: Customer menggunakan PHONE NUMBER, bukan email!
###############################################

@baseUrl = http://localhost:5000
@customerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjRmMTk4MTQ1LTA2YWItNGY4NS04ZjNiLTUyMjRmYWI3OWQ0NiIsInBob25lX251bWJlciI6IjYyODU4ODU3MjUwMjciLCJ0eXBlIjoiY3VzdG9tZXIiLCJpYXQiOjE3NjE1ODIxNzAsImV4cCI6MTc2MTY2ODU3MH0.cYf7k4DJBk_j6cORIrhu1x4J7NjZP7ZSHs_cjlp048M

# Default Test Credentials (buat dulu via register)
@customerPhone = 085885725027
@customerPassword = 123456
@customerName = Customer Test

###############################################
# AUTHENTICATION
###############################################

### 1. Register New Customer
POST {{baseUrl}}/api/customer/auth/register
Content-Type: application/json

{
  "phone_number": "{{customerPhone}}",
  "full_name": "{{customerName}}",
  "password": "{{customerPassword}}",
  "address": "Jl. Merdeka No. 123, Jakarta Pusat, DKI Jakarta"
}

### 2. Login Customer
# IMPORTANT: Copy token dari response dan paste ke @customerToken di atas
POST {{baseUrl}}/api/customer/auth/login
Content-Type: application/json

{
  "phone_number": "{{customerPhone}}",
  "password": "{{customerPassword}}"
}

### 3. Get Customer Profile (Need Authentication)
GET {{baseUrl}}/api/customer/auth/profile
Content-Type: application/json
Authorization: Bearer {{customerToken}}

