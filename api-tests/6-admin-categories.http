###############################################
# ADMIN CATEGORY MANAGEMENT API
# Endpoint: /api/admin/categories/*
# Authentication: Required (Admin Token)
###############################################

@baseUrl = http://localhost:5000

# Admin Credentials - PENTING: Menggunakan PHONE NUMBER, bukan email
@adminPhone = 082111111111
@adminPassword = admin123

# Paste token setelah login di 4-admin-auth.http
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjOGRlMmMzNy01ODU5LTQ2ZmQtYmY5Yy05ZDE5YzIwMWNjZGYiLCJ0eXBlIjoiYWRtaW4iLCJpYXQiOjE3NjE5OTYxNzIsImV4cCI6MTc2MjYwMDk3Mn0.Uv4znICVdfWw66ar71fcuD_JwudDdTn7Qz4Ye5opELQ

# Sample ID
@categoryId = paste-category-id-here

###############################################
# CATEGORY MANAGEMENT
###############################################

### 1. Get All Categories (Admin)
GET {{baseUrl}}/api/admin/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 2. Create New Category
POST {{baseUrl}}/api/admin/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Sayuran Organik",
  "description": "Sayuran segar organik tanpa pestisida, langsung dari petani lokal"
}

### 3. Update Category
PUT {{baseUrl}}/api/admin/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Sayuran Premium",
  "description": "Sayuran segar premium berkualitas tinggi"
}

### 4. Delete Category
DELETE {{baseUrl}}/api/admin/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

