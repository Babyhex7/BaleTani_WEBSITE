###############################################
# ADMIN ORDER MANAGEMENT API
# Endpoint: /api/admin/orders/*
# Authentication: Required (Admin Token)
###############################################

@baseUrl = http://localhost:5000

# Admin Credentials
@adminPhone = 082111111111
@adminPassword = admin123

# Paste token setelah login
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjOGRlMmMzNy01ODU5LTQ2ZmQtYmY5Yy05ZDE5YzIwMWNjZGYiLCJ0eXBlIjoiYWRtaW4iLCJpYXQiOjE3NjE5OTYxNzIsImV4cCI6MTc2MjYwMDk3Mn0.Uv4znICVdfWw66ar71fcuD_JwudDdTn7Qz4Ye5opELQ

# Sample IDs
@orderId = paste-order-id-here

###############################################
# ORDER MANAGEMENT
###############################################

### 1. Get All Orders
GET {{baseUrl}}/api/admin/orders
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 2. Get All Orders with Pagination
GET {{baseUrl}}/api/admin/orders?page=1&limit=10
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 3. Filter Orders by Status
GET {{baseUrl}}/api/admin/orders?order_status=pending_payment&payment_status=unpaid
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 4. Filter Orders by Payment Method
GET {{baseUrl}}/api/admin/orders?payment_method=transfer&delivery_method=delivery
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 5. Filter Orders by Date Range
GET {{baseUrl}}/api/admin/orders?date_from=2025-11-01&date_to=2025-11-30
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 6. Search Orders
GET {{baseUrl}}/api/admin/orders?search=ORD
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 6a. Filter Orders by Type - Online
GET {{baseUrl}}/api/admin/orders?order_type=online
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 6b. Filter Orders by Type - Offline
GET {{baseUrl}}/api/admin/orders?order_type=offline
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 6c. Filter Orders by Type and Status
GET {{baseUrl}}/api/admin/orders?order_type=online&order_status=paid
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 7. Get Order Detail
GET {{baseUrl}}/api/admin/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

###############################################
# UPDATE ORDER STATUS
###############################################

### 8. Update Payment Status to Paid
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "payment_status": "paid",
  "notes": "Pembayaran telah dikonfirmasi via transfer BCA"
}

### 9. Update Order Status to Processing
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "processing",
  "notes": "Pesanan sedang diproses"
}

### 10. Update Order Status to Shipped
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "shipped",
  "notes": "Paket sudah dikirim via JNE REG, no resi: 123456789"
}

### 11. Update Order Status to Delivered
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "order_status": "delivered",
  "notes": "Pesanan telah diterima customer"
}

### 12. Update Both Payment and Order Status
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "payment_status": "paid",
  "order_status": "processing",
  "notes": "Pembayaran confirmed, mulai proses pesanan"
}

###############################################
# ADMIN NOTES & CANCEL
###############################################

### 13. Update Admin Notes
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/notes
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "admin_notes": "Customer request pengiriman sore hari. Pastikan dikemas dengan bubble wrap ekstra."
}

### 14. Cancel Order
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/cancel
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "cancelled_reason": "Customer request pembatalan, stok produk habis"
}

### 15. Cancel Order - Pembayaran Bermasalah
PUT {{baseUrl}}/api/admin/orders/{{orderId}}/cancel
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "cancelled_reason": "Bukti transfer tidak valid, customer tidak merespon konfirmasi"
}

###############################################
# STATISTICS
###############################################

### 16. Get Order Statistics
GET {{baseUrl}}/api/admin/orders/statistics
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 17. Get Statistics by Date Range
GET {{baseUrl}}/api/admin/orders/statistics?date_from=2025-11-01&date_to=2025-11-30
Content-Type: application/json
Authorization: Bearer {{adminToken}}

###############################################
# SORTING & FILTERING COMBINATIONS
###############################################

### 18. Get Pending Orders (Sorted by Date, Newest First)
GET {{baseUrl}}/api/admin/orders?order_status=pending_payment&sort_by=created_at&sort_order=DESC
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 19. Get Completed Orders (Last 7 Days)
GET {{baseUrl}}/api/admin/orders?order_status=delivered&date_from=2025-10-25&date_to=2025-11-01
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 20. Get Unpaid Transfer Orders
GET {{baseUrl}}/api/admin/orders?payment_method=transfer&payment_status=unpaid
Content-Type: application/json
Authorization: Bearer {{adminToken}}

###############################################
# NOTES:
# 
# Order Status Flow:
# pending_payment → paid → processing → shipped → delivered
#                                               → cancelled
#
# Payment Status:
# - unpaid: Belum bayar
# - paid: Sudah bayar
# - refunded: Dikembalikan
#
# Available Order Statuses:
# - pending_payment
# - paid
# - processing
# - shipped
# - delivered
# - cancelled
# - checkout
# - out_for_delivery
# - completed
#
# Available Payment Methods:
# - cash
# - transfer
# - qris
#
# Available Delivery Methods:
# - self_pickup
# - delivery
###############################################
