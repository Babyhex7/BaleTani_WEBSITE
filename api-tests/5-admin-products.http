###############################################
# ADMIN PRODUCT MANAGEMENT API
# Endpoint: /api/admin/products/*
# Authentication: Required (Admin Token)
###############################################

@baseUrl = http://localhost:5000

# Admin Credentials (untuk login) - PENTING: Menggunakan PHONE NUMBER, bukan email
@adminPhone = 082111111111
@adminPassword = admin123

# Paste token setelah login di 4-admin-auth.http
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiJjOGRlMmMzNy01ODU5LTQ2ZmQtYmY5Yy05ZDE5YzIwMWNjZGYiLCJ0eXBlIjoiYWRtaW4iLCJpYXQiOjE3NjE5OTYxNzIsImV4cCI6MTc2MjYwMDk3Mn0.Uv4znICVdfWw66ar71fcuD_JwudDdTn7Qz4Ye5opELQ

# Sample IDs (akan otomatis terisi setelah create/get)
@productId = paste-product-id-here
@categoryId = paste-category-id-here

###############################################
# PRODUCT MANAGEMENT
###############################################

### 1. Get All Products (Admin - includes deleted)
GET {{baseUrl}}/api/admin/products?page=1&limit=10
Content-Type: application/json
Authorization: Bearer {{adminToken}}

### 2. Create New Product
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Tomat Cherry Segar",
  "description": "Tomat cherry segar dari petani lokal, cocok untuk salad dan snack sehat",
  "price": 25000,
  "stock": 50,
  "unit": "kg",
  "category_id": "{{categoryId}}"
}

### 3. Update Product
PUT {{baseUrl}}/api/admin/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Tomat Cherry Premium",
  "price": 28000,
  "stock": 75,
  "description": "Tomat cherry premium berkualitas tinggi"
}

### 4. Delete Product (Soft Delete)
DELETE {{baseUrl}}/api/admin/products/{{productId}}
Authorization: Bearer {{adminToken}}

