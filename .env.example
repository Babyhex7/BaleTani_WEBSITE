# ============================================
# BaleTani - Environment Variables Template
# Copy this file to .env and update values
# ============================================

# ============================================
# GENERAL
# ============================================
NODE_ENV=development

# ============================================
# DATABASE - MySQL
# ============================================
DB_ROOT_PASSWORD=rootpassword
DB_NAME=baletani
DB_USER=baletani_user
DB_PASSWORD=baletani_password
DB_HOST=mysql
DB_PORT=3306

# ============================================
# AUTHENTICATION
# ============================================
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# REDIS CACHING
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# SERVICES PORTS
# ============================================
BACKEND_PORT=5000
FRONTEND_PORT=80
ML_PORT=8000

# ============================================
# FRONTEND BUILD
# ============================================
VITE_API_URL=/api
VITE_ML_API_URL=/ml-api

# ============================================
# EXTERNAL SERVICES
# ============================================
WHATSAPP_ADMIN_PHONE=6287735517999
