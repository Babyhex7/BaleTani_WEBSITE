{
  "name": "Product Management API Tests",
  "description": "Test collection untuk Product Management endpoints",
  "baseUrl": "http://localhost:5000/api/admin/products",
  "authToken": "Bearer YOUR_SUPER_ADMIN_TOKEN_HERE",
  
  "tests": {
    "1_create_product": {
      "method": "POST",
      "endpoint": "/",
      "headers": {
        "Authorization": "{{authToken}}",
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Bayam Segar",
        "product_type": "online",
        "category_id": "UUID_KATEGORI_SAYUR",
        "description": "Bayam segar organik langsung dari petani lokal",
        "selling_price": 15000,
        "unit": "kg",
        "shelf_life_days": 3,
        "is_active": true
      },
      "expected": {
        "status": 201,
        "success": true
      }
    },

    "2_get_all_products": {
      "method": "GET",
      "endpoint": "/?page=1&limit=10",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "3_get_all_products_with_filters": {
      "method": "GET",
      "endpoint": "/?page=1&limit=10&product_type=online&is_active=true&search=bayam",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "4_get_product_by_id": {
      "method": "GET",
      "endpoint": "/PRODUCT_ID_HERE",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "5_update_product": {
      "method": "PUT",
      "endpoint": "/PRODUCT_ID_HERE",
      "headers": {
        "Authorization": "{{authToken}}",
        "Content-Type": "application/json"
      },
      "body": {
        "name": "Bayam Segar Premium",
        "selling_price": 18000,
        "description": "Bayam segar premium organik"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "6_upload_product_images": {
      "method": "POST",
      "endpoint": "/PRODUCT_ID_HERE/images",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "note": "Use multipart/form-data with field name 'images' (multiple files, max 5)",
      "body": {
        "type": "form-data",
        "images": "FILE_1, FILE_2, FILE_3"
      },
      "expected": {
        "status": 201,
        "success": true
      }
    },

    "7_get_product_images": {
      "method": "GET",
      "endpoint": "/PRODUCT_ID_HERE/images",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "8_reorder_product_images": {
      "method": "PUT",
      "endpoint": "/PRODUCT_ID_HERE/images/reorder",
      "headers": {
        "Authorization": "{{authToken}}",
        "Content-Type": "application/json"
      },
      "body": {
        "images": [
          { "id": "IMAGE_ID_1", "display_order": 2 },
          { "id": "IMAGE_ID_2", "display_order": 1 },
          { "id": "IMAGE_ID_3", "display_order": 3 }
        ]
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "9_delete_product_image": {
      "method": "DELETE",
      "endpoint": "/images/IMAGE_ID_HERE",
      "headers": {
        "Authorization": "{{authToken}}",
        "Content-Type": "application/json"
      },
      "body": {
        "reason": "Gambar tidak sesuai standar"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    },

    "10_soft_delete_product": {
      "method": "DELETE",
      "endpoint": "/PRODUCT_ID_HERE",
      "headers": {
        "Authorization": "{{authToken}}",
        "Content-Type": "application/json"
      },
      "body": {
        "reason": "Produk sudah tidak dijual"
      },
      "expected": {
        "status": 200,
        "success": true
      },
      "note": "Only super_admin can delete"
    },

    "11_restore_product": {
      "method": "POST",
      "endpoint": "/PRODUCT_ID_HERE/restore",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      },
      "note": "Only super_admin can restore"
    },

    "12_get_low_stock_products": {
      "method": "GET",
      "endpoint": "/?stock_below=10&sort_by=total_stock&sort_order=ASC",
      "headers": {
        "Authorization": "{{authToken}}"
      },
      "expected": {
        "status": 200,
        "success": true
      }
    }
  },

  "instructions": {
    "setup": [
      "1. Pastikan server backend sudah running (npm run dev)",
      "2. Login sebagai super_admin untuk mendapatkan token JWT",
      "3. Ganti {{authToken}} dengan token yang didapat",
      "4. Ganti PRODUCT_ID_HERE, IMAGE_ID_HERE, UUID_KATEGORI_SAYUR dengan ID yang valid"
    ],
    "tools": [
      "Postman: Import JSON ini sebagai collection",
      "Thunder Client (VS Code): Copy endpoint dan body ke request",
      "cURL: Convert JSON ke cURL command"
    ]
  },

  "sample_responses": {
    "success_create": {
      "success": true,
      "message": "Produk berhasil ditambahkan",
      "data": {
        "id": "uuid-here",
        "name": "Bayam Segar",
        "product_type": "online",
        "selling_price": "15000.00",
        "unit": "kg",
        "shelf_life_days": 3,
        "total_stock": "0.00",
        "is_active": true,
        "category": {
          "id": "uuid",
          "category_name": "Sayuran"
        }
      }
    },
    "success_get_all": {
      "success": true,
      "message": "Data produk berhasil diambil",
      "data": {
        "products": [],
        "pagination": {
          "total": 10,
          "page": 1,
          "limit": 10,
          "total_pages": 1
        }
      }
    },
    "error_not_found": {
      "success": false,
      "message": "Produk tidak ditemukan"
    },
    "error_validation": {
      "success": false,
      "message": "Data tidak lengkap. Field name, product_type, selling_price, unit, dan shelf_life_days wajib diisi"
    },
    "error_unauthorized": {
      "success": false,
      "message": "Akses ditolak. Token tidak tersedia."
    },
    "error_forbidden": {
      "success": false,
      "message": "Akses ditolak. Permissions tidak mencukupi."
    }
  }
}
