# ===========================================
# BACKEND ENVIRONMENT VARIABLES - DEVELOPMENT
# ===========================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=baletani_db
DB_USER=root
DB_PASSWORD=

# JWT Configuration
# Generate new secret using: node scripts/generateJwtSecret.js
JWT_SECRET=your_development_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_CUSTOMER_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# WhatsApp Configuration
WHATSAPP_ADMIN_PHONE=6287735517999

# AI Recommendation Service
ML_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=debug
