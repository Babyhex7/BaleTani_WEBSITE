# ===========================================
# BACKEND ENVIRONMENT VARIABLES - PRODUCTION
# ===========================================

# Application Environment
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=your_production_db_host
DB_PORT=3306
DB_NAME=baletani_db_production
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password

# JWT Configuration
# IMPORTANT: Generate a strong secret using: node scripts/generateJwtSecret.js
# NEVER use the development secret in production!
JWT_SECRET=your_production_jwt_secret_here_MUST_BE_DIFFERENT
JWT_EXPIRES_IN=7d

# CORS Configuration
# Replace with your actual production URLs
FRONTEND_CUSTOMER_URL=https://your-customer-domain.com
FRONTEND_ADMIN_URL=https://your-admin-domain.com

# WhatsApp Configuration
WHATSAPP_ADMIN_PHONE=6285885725027

# AI Recommendation Service
ML_SERVICE_URL=http://localhost:8000

# Logging
LOG_LEVEL=error

# Security Notes:
# 1. Never commit .env file to version control
# 2. Use strong, unique JWT secret for production
# 3. Use secure database passwords
# 4. Enable SSL/TLS for database connections in production
# 5. Set proper CORS URLs for your production domains
